# ==========================================================
# 2. Server Logic 
# ==========================================================
server <- function(input, output, session) {
  
  lat_epic <- 52.25
  lon_epic <- 5.22
  tijdzone <- "Europe/Amsterdam"
  
  geo_locaties <- data.frame(
    naam = c("Laren (NH)", "Bergen op Zoom", "Groningen"),
    lat = c(52.25, 51.4947, 53.2194),
    lon = c(5.22, 4.2875, 6.5665)
  )
  
  obs_data <- data.frame(
    id = 1:8,
    naam = c("Deneb (Zwaan)", "Altair (Adelaar)", "Enif (Pegasus)", "Markab (Pegasus)", 
             "Algedi (Steenbok)", "Sadalmelik (Waterman)", "Sualocin (Dolfijn)", "Anser (Vosje)"),
    ra_h = c(20.69, 19.85, 21.73, 23.08, 20.30, 22.09, 20.66, 19.48),
    dec = c(45.28, 8.87, 9.87, 15.20, -12.51, -0.31, 15.95, 24.66),
    type = "ster"
  )
  
  m15 <- data.frame(id=9, naam="M15 Cluster", ra_h=21.50, dec=12.17, type="cluster")
  base_objects <- rbind(obs_data, m15)
  
  verbindingen <- list(
    c(1, 3), c(3, 4), c(2, 7), c(7, 8), c(4, 6), c(5, 6)
  )
  
  sky_data <- reactive({
    invalidateLater(1000, session)
    
    nu <- Sys.time()
    nu_utc <- nu
    attr(nu_utc, "tzone") <- "UTC"
    
    jd <- as.numeric(difftime(nu_utc, as.POSIXct("2000-01-01 12:00:00", tz="UTC"), units="days"))
    lst <- (280.4606 + 360.9856 * jd + lon_epic) %% 360
    
    L <- (218.316 + 13.176396 * jd) %% 360 
    F_arg <- (93.272 + 13.229350 * jd) %% 360  
    moon_ra <- L 
    moon_dec <- 5 * sin(F_arg * pi/180) 
    
    current_sky <- rbind(base_objects, data.frame(id=10, naam="De Maan", ra_h=moon_ra/15, dec=moon_dec, type="moon"))
    
    rad <- pi/180
    lat_r <- lat_epic * rad
    
    current_sky$alt <- 0
    current_sky$az <- 0
    current_sky$x <- 0
    current_sky$y <- 0
    
    for(i in 1:nrow(current_sky)) {
      ha <- (lst - (current_sky$ra_h[i] * 15)) * rad
      dec_r <- current_sky$dec[i] * rad
      
      sin_alt <- sin(dec_r)*sin(lat_r) + cos(dec_r)*cos(lat_r)*cos(ha)
      alt <- asin(sin_alt)
      
      cos_az <- (sin(dec_r) - sin(lat_r)*sin_alt) / (cos(lat_r)*cos(alt))
      sin_az <- -(sin(ha)*cos(dec_r)) / cos(alt)
      az <- atan2(sin_az, cos_az)
      
      current_sky$alt[i] <- alt / rad
      current_sky$az[i] <- (az / rad + 360) %% 360
      
      r_norm <- cos(alt)
      current_sky$x[i] <- r_norm * cos(current_sky$az[i] * rad)
      current_sky$y[i] <- r_norm * -sin(current_sky$az[i] * rad) 
    }
    
    list(sky = current_sky, time = nu, lst = lst)
  })
  
  output$liveStats <- renderUI({
    data <- sky_data()
    tijd_lokaal <- format(data$time, "%H:%M:%S %Z", tz = tijdzone)
    
    regen_start <- "21:45"
    onweer_status <- "ACTIEF - Zware cel nadert vanuit ZW (Verwachting: 23:15)"
    
    HTML(paste(
      "<div style='text-align:center;'>",
      "<b>Locatie Epicentrum:</b> Laren, NH (52.25\u00b0N, 5.22\u00b0O)<br>",
      "<b>Actuele Tijd:</b>", tijd_lokaal, "<br>",
      "<b>LST:</b>", sprintf("%.2f\u00b0", data$lst), 
      "<hr style='border-color:#30363d; margin: 10px 0;'>",
      "<span style='color:#e74c3c; font-weight:bold; letter-spacing:1px;'>\u26A0 METEO ALERT</span><br>",
      "<span style='color:#8b949e;'>Regenval gestart: </span> <span style='color:#58a6ff;'>", regen_start, " CEST</span><br>",
      "<span style='color:#8b949e;'>Onweer: </span> <span style='color:#ff7b72;'>", onweer_status, "</span>",
      "</div>"
    ))
  })
  
  output$dynamicLegend <- renderUI({
    data <- sky_data()$sky
    data <- data[order(-data$alt), ]
    
    table_rows <- lapply(1:nrow(data), function(i) {
      obj <- data[i, ]
      icon <- "●"; col <- "white"
      if(obj$type == "moon") { icon <- "◑"; col <- "yellow" }
      if(obj$type == "cluster") { icon <- "✳"; col <- "#ff7b72" }
      
      paste0(
        "<tr>",
        "<td style='color:", col, "; width: 20px;'>", icon, "</td>",
        "<td><b>", obj$naam, "</b></td>",
        "<td style='text-align:right;'>", sprintf("%.2f\u00b0", obj$alt), "</td>",
        "<td style='text-align:right;'>", sprintf("%.2f\u00b0", obj$az), "</td>",
        "</tr>"
      )
    })
    
    HTML(paste0(
      "<table class='coord-table'>",
      "<tr><th>Icoon</th><th>Object</th><th style='text-align:right;'>Hoogte</th><th style='text-align:right;'>Azimut</th></tr>",
      paste(table_rows, collapse=""),
      "</table>"
    ))
  })
  
  output$starRadar <- renderPlot({
    sdata <- sky_data()
    current_sky <- sdata$sky
    lst <- sdata$lst
    zoom_radius <- input$zoomLvl
    rad <- pi/180
    
    center_x <- 0
    center_y <- 0
    
    if(input$focusObj != "zenit") {
      target <- current_sky[current_sky$naam == input$focusObj, ]
      if(nrow(target) > 0) {
        center_x <- target$x[1]
        center_y <- target$y[1]
      }
    }
    
    # +20% padding op de x/y limieten zodat de labels in de buitenring leesbaar blijven
    lim_x <- c(center_x - (zoom_radius * 1.2), center_x + (zoom_radius * 1.2))
    lim_y <- c(center_y - (zoom_radius * 1.2), center_y + (zoom_radius * 1.2))
    
    par(bg="#05070a", mar=c(0,0,0,0))
    plot(0, 0, type="n", xlim=lim_x, ylim=lim_y, asp=1, axes=FALSE, xlab="", ylab="")
    
    try({
      map("world", projection="orthographic", orientation=c(lat_epic, lon_epic, 90),
          col="#0f2b48", fill=TRUE, bg="#05070a", border="#1f6feb88", resolution=0,
          add=TRUE)
    }, silent = TRUE)
    
    theta <- seq(0, 2*pi, length.out=200)
    polygon(cos(theta), sin(theta), col=NA, border="#1f6feb", lwd=2)
    
    # ----------------------------------------------------
    # Tijdseenheden (0-24h) en Gradenboog (0-360) 
    # ----------------------------------------------------
    for(az_deg in seq(0, 355, by=5)) {
      az_r <- az_deg * rad
      is_main <- (az_deg %% 30 == 0)
      
      r_in <- 1.0
      r_out <- ifelse(is_main, 1.03, 1.01)
      
      lines(c(r_in*cos(az_r), r_out*cos(az_r)), 
            c(r_in*-sin(az_r), r_out*-sin(az_r)), 
            col="#58a6ff88", lwd=ifelse(is_main, 2, 1))
      
      if(is_main) {
        h <- az_deg / 15
        txt_x <- 1.10 * cos(az_r)
        txt_y <- 1.10 * -sin(az_r)
        
        # Geen overlappende tekst printen bij de kardinale richtingen
        if(!az_deg %in% c(0, 90, 180, 270)) {
          text(txt_x, txt_y, sprintf("%d°\n%dh", az_deg, h), col="#58a6ffaa", cex=0.7)
        }
      }
    }
    
    # ----------------------------------------------------
    # Markering van de 150-graden Getijden-as
    # ----------------------------------------------------
    az_150 <- 150 * rad
    x150 <- cos(az_150)
    y150 <- -sin(az_150)
    lines(c(0, x150), c(0, y150), col="#ff00ff", lwd=2, lty=2)
    text(1.15 * x150, 1.15 * y150, "150°\nGetijden-as", col="#ff00ff", font=2, cex=0.8)
    
    lines(c(-1, 1), c(0, 0), col="#1f6feb55", lty=2) 
    lines(c(0, 0), c(-1, 1), col="#1f6feb55", lty=2) 
    
    for(alt_deg in c(30, 60)) { 
      r_circ <- cos(alt_deg * rad)
      lines(r_circ*cos(theta), r_circ*sin(theta), col="#1f6feb44", lty=2) 
    }
    
    for(ra_deg in seq(0, 330, by=30)) {
      ha <- (lst - ra_deg) * rad
      line_r <- seq(0, 1, length.out=40)
      line_x <- line_r * cos(ha)
      line_y <- line_r * -sin(ha)
      lines(line_x, line_y, col="#00f2fe33", lty=3, lwd=1)
    }
    
    p_locs <- mapproject(geo_locaties$lon, geo_locaties$lat, projection="orthographic", orientation=c(lat_epic, lon_epic, 90))
    points(p_locs$x, p_locs$y, col="#ff7b72", pch=19, cex=1.3)
    points(p_locs$x[1], p_locs$y[1], col="#ff7b72", pch=1, cex=3, lwd=2)
    text(p_locs$x, p_locs$y - 0.03, geo_locaties$naam, col="#ff7b72", font=2, cex=0.9)
    
    # Kardinale Richtingen
    text(0, 1.05, "W (270° / 18h)", col="#58a6ff", font=2, cex=0.9)
    text(0, -1.05, "O (90° / 6h)", col="#58a6ff", font=2, cex=0.9)
    text(1.08, 0, "N (0°/0h)", col="#58a6ff", font=2, cex=0.9)
    text(-1.08, 0, "Z (180°/12h)", col="#58a6ff", font=2, cex=0.9)
    
    for(v in verbindingen) {
      o1 <- current_sky[current_sky$id == v[1], ]
      o2 <- current_sky[current_sky$id == v[2], ]
      if(nrow(o1) > 0 && nrow(o2) > 0 && o1$alt > -5 && o2$alt > -5) {
        lines(c(o1$x, o2$x), c(o1$y, o2$y), col="#00f2feaa", lwd=1.8, lty=1)
      }
    }
    
    zichtbaar <- current_sky[current_sky$alt > -10, ]
    
    if(nrow(zichtbaar) > 0) {
      for(i in 1:nrow(zichtbaar)) {
        p_col <- "white"
        p_pch <- 19
        p_cex <- 1.4
        
        if(zichtbaar$type[i] == "moon") { p_col <- "yellow"; p_pch <- 18; p_cex <- 3.2 }
        if(zichtbaar$type[i] == "cluster") { p_col <- "#ff7b72"; p_pch <- 8; p_cex <- 2.2 }
        
        if(zichtbaar$naam[i] == input$focusObj && input$focusObj != "zenit") {
          points(zichtbaar$x[i], zichtbaar$y[i], pch=1, col="#ff7b72", cex=p_cex*3, lwd=2)
          points(zichtbaar$x[i], zichtbaar$y[i], pch=3, col="#ff7b72", cex=p_cex*4, lwd=1)
        }
        
        points(zichtbaar$x[i], zichtbaar$y[i], pch=p_pch, col=adjustcolor(p_col, 0.3), cex=p_cex*2.5)
        points(zichtbaar$x[i], zichtbaar$y[i], pch=p_pch, col=p_col, cex=p_cex)
        text(zichtbaar$x[i], zichtbaar$y[i] - (zoom_radius*0.04), zichtbaar$naam[i], col="gray90", cex=1.1, font=2)
      }
    }
    
    if(input$focusObj != "zenit") {
      target <- current_sky[current_sky$naam == input$focusObj, ]
      if(nrow(target) > 0 && target$alt[1] < 0) {
        text(center_x, center_y + (zoom_radius*0.8), "WAARSCHUWING: Object onder de horizon", col="red", font=2, cex=1.2)
      }
    }
  })
}

shinyApp(ui, server)